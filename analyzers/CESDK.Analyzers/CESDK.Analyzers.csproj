<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Domain diagnostics for CESDK plugin code: plugin shape and bootstrap (CESDK0xxx), runtime-safety usage (CESDK1xxx), generator input (CESDK2xxx).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets the code fixes read the Diagnostic.Properties keys and values without making them public API. CESDK.Analyzers.Tests gets access from Directory.Build.props. -->
    <InternalsVisibleTo Include="CESDK.Analyzers.CodeFixes"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Code shared with the generators, including the LuaBindings input validation the CESDK2xxx rules apply. Its assembly must sit next to this one wherever this one is loaded. -->
    <ProjectReference Include="../../source-generators/CESDK.SourceGenerators.Shared/CESDK.SourceGenerators.Shared.csproj"/>
  </ItemGroup>

</Project>
