<Project>
  <!-- Profile for src/ and libs/: the net10.0 assemblies embedded in the CheatEngine.SDK package. AllowUnsafeBlocks is set per project. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!--
      IsAotCompatible already implies every property below it (IsTrimmable, EnableTrimAnalyzer,
      EnableAotAnalyzer, EnableSingleFileAnalyzer); they are restated explicitly so the guarantee
      survives a future SDK change to what IsAotCompatible implies, matching this file's existing
      preference for explicit over implicit (dotnet_style_require_accessibility_modifiers=always,
      the var_* rules in .editorconfig). Confirmed zero behavior change against the implied defaults.
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- Fail the shipping graph when a referenced assembly has not declared its AOT compatibility. -->
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <!-- Trim-compatibility (IL2125) is a distinct opt-in from AOT-compatibility (IL3058) verification above. -->
    <VerifyReferenceTrimCompatibility>true</VerifyReferenceTrimCompatibility>
    <!-- Interop-heavy code: raise three analysis categories and keep the rest at recommended. -->
    <AnalysisModeInteroperability>All</AnalysisModeInteroperability>
    <AnalysisModeSecurity>All</AnalysisModeSecurity>
    <AnalysisModeReliability>All</AnalysisModeReliability>
  </PropertyGroup>

  <PropertyGroup Label="Assembly metadata">
    <Authors>AriusII;ShadowNineX</Authors>
    <Product>CheatEngine.SDK</Product>
    <Copyright>Copyright (c) AriusII, ShadowNineX and CheatEngine.SDK contributors</Copyright>
    <RepositoryUrl>https://github.com/CheatEngineNet/CheatEngine.SDK</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reports RS0030 on every use of a symbol listed in BannedSymbols.txt. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all"/>
    <AdditionalFiles Include="$(RepoRoot)eng/BannedSymbols.txt" Visible="false"/>
  </ItemGroup>

  <!--
    libs/ only: src/CheatEngine.SDK declares no type of its own. The analyzer picks up PublicAPI.Shipped.txt and
    PublicAPI.Unshipped.txt next to the project; CESDK9003 (Directory.Build.targets) fails a library without them, because
    a missing file silently disables tracking. Shipped is the surface of the published CheatEngine.SDK 1.0.0 package and
    only changes at a release; every change lands in Unshipped.
  -->
  <ItemGroup Label="Public API tracking (RS0016/RS0017)" Condition="$(_CheatEngineSdkFolder.StartsWith('libs/'))">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all"/>
  </ItemGroup>
</Project>
