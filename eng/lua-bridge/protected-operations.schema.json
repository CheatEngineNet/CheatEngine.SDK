{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cheat-engine/cheat-engine-sdk/eng/lua-bridge/protected-operations.schema.json",
  "title": "CheatEngine.SDK protected Lua-operation catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "host",
    "bridgeContract",
    "classificationPreconditions",
    "operations",
    "directApiPolicy"
  ],
  "properties": {
    "$schema": { "const": "./protected-operations.schema.json" },
    "schemaVersion": { "const": 1 },
    "catalogId": { "const": "cheatengine-sdk-lua-protected-operations" },
    "host": { "$ref": "#/$defs/host" },
    "bridgeContract": { "$ref": "#/$defs/bridgeContract" },
    "classificationPreconditions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    },
    "directApiPolicy": {
      "type": "array",
      "items": { "$ref": "#/$defs/directApiPolicy" }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "ExactBinary",
        "ExactInstalledFile",
        "PinnedUpstream",
        "ObservedLive",
        "Inferred",
        "Unknown"
      ]
    },
    "raises": { "enum": ["never", "memory", "any"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "symbol", "status", "source", "verifiedOn", "verification"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "source": { "type": "string", "format": "uri" },
        "verifiedOn": { "type": "string", "format": "date" },
        "verification": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version", "architecture", "lua", "evidence"],
      "properties": {
        "product": { "const": "Cheat Engine" },
        "version": { "const": "7.7.0.10621" },
        "architecture": { "const": "x64" },
        "lua": {
          "type": "object",
          "additionalProperties": false,
          "required": ["majorMinor", "fixtureSha256"],
          "properties": {
            "majorMinor": { "const": "5.3" },
            "fixtureSha256": { "const": "C95DCDFA0F60F97B43D970D77FD1BB907AF4DE04B500A3C89A99600B20B35BD2" }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenance" }
        }
      }
    },
    "bridgeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abiMajor", "minimumAbiMinor", "operationBitmapWidth", "operationBitmap"],
      "properties": {
        "abiMajor": { "const": 1 },
        "minimumAbiMinor": { "const": 1 },
        "operationBitmapWidth": { "const": 64 },
        "operationBitmap": { "pattern": "^0x[0-9A-F]{16}$" }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "inputCount", "inputDescription", "success", "failure"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "inputCount": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "minLength": 1 }] },
        "inputDescription": { "type": "string", "minLength": 1 },
        "success": { "$ref": "#/$defs/stackOutcome" },
        "failure": { "$ref": "#/$defs/stackOutcome" }
      }
    },
    "stackOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resultCount", "delta"],
      "properties": {
        "resultCount": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "minLength": 1 }] },
        "delta": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nativeEnum",
        "managed",
        "opcode",
        "capability",
        "protected",
        "requiresNativeProtection",
        "raises",
        "stack",
        "ownership",
        "hostOperation",
        "provenance"
      ],
      "properties": {
        "id": { "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "nativeEnum": { "pattern": "^OP_[A-Z0-9_]+$" },
        "managed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["constant", "wrapper"],
          "properties": {
            "constant": { "pattern": "^[A-Z][A-Za-z0-9]*Operation$" },
            "wrapper": { "pattern": "^[A-Z][A-Za-z0-9]*$" }
          }
        },
        "opcode": { "type": "integer", "minimum": 0, "maximum": 63 },
        "capability": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "protected": { "const": true },
        "requiresNativeProtection": { "const": true },
        "raises": { "$ref": "#/$defs/raises" },
        "successPathRaises": { "$ref": "#/$defs/raises" },
        "provenanceConflict": { "type": "string" },
        "conditionalFastPath": { "type": "string" },
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "consumerCount", "note"],
          "properties": {
            "state": { "enum": ["active", "supported-unused"] },
            "consumerCount": { "type": "integer", "minimum": 0 },
            "candidateRetirement": { "type": "boolean" },
            "note": { "type": "string", "minLength": 1 }
          }
        },
        "stack": { "$ref": "#/$defs/stack" },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "result"],
          "properties": {
            "input": { "type": "string", "minLength": 1 },
            "result": { "type": "string", "minLength": 1 },
            "registry": { "type": "string" }
          }
        },
        "hostOperation": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenance" }
        }
      }
    },
    "directApiPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managedSymbol", "nativeSymbol", "raises", "allowedDirectly", "requiresBridge", "reason", "provenance"],
      "properties": {
        "managedSymbol": { "pattern": "^CheatEngine\\.SDK\\.Lua\\.Interop\\.Api\\.LuaApi\\.[A-Za-z0-9_]+$" },
        "nativeSymbol": { "pattern": "^[A-Za-z0-9_]+$" },
        "raises": { "$ref": "#/$defs/raises" },
        "allowedDirectly": { "type": "boolean" },
        "requiresBridge": { "type": "boolean" },
        "bridgeOperation": { "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "conditionalDirectUse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "when", "proof"],
          "properties": {
            "allowed": { "const": true },
            "when": { "type": "string", "minLength": 1 },
            "proof": { "type": "string", "minLength": 1 }
          }
        },
        "reason": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/provenance" }
        }
      }
    }
  }
}
