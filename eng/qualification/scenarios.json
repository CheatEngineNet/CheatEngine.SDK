        { "id": "throw", "kind": "Lua", "action": "call", "function": "ce77_live_probe_throw_managed_exception" },
        { "id": "status", "kind": "Lua", "action": "call", "function": "ce77_live_probe_status_json" }
      ],
      "observe": [ "throw:0", "status:managedExceptionThrows" ],
      "passRule": {
        "kind": "Automated",
        "passKind": "Functional",
