{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CheatEngineNet/CheatEngine.SDK/blob/main/eng/release/release-tuple.v0.schema.json",
  "title": "CheatEngine.SDK release tuple v0",
  "description": "Ties one released CheatEngine.SDK package to its source, build, native bridge, Cheat Engine profile, qualification evidence, SBOM, attestations and release assets. Written by eng/release/New-ReleaseTuple.ps1: PrePublish on the draft release, Published once nuget.org serves the package. SHA-256 values are 64 lowercase hex digits; SHA-512 values are standard base64 with padding; hashes of committed JSON files are taken after CRLF to LF normalization (the git blob bytes).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stage",
    "package",
    "source",
    "build",
    "nativeBridge",
    "ceProfile",
    "qualification",
    "sbom",
    "attestations",
    "assets",
    "createdUtc"
  ],
  "properties": {
    "schema": {
      "const": "cheatengine-release-tuple/v0"
    },
    "stage": {
      "enum": [
        "PrePublish",
        "Published"
      ]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "attestedAssetSha256",
        "contentHashSha512",
        "nugetOrgSignedSha256",
        "nugetOrgSignedSha512",
        "repositorySignatureVerified"
      ],
      "properties": {
        "id": {
          "const": "CheatEngine.SDK"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "attestedAssetSha256": {
          "description": "SHA-256 of the unsigned nupkg that CI tested, attested and attached to the release.",
          "$ref": "#/$defs/sha256"
        },
        "contentHashSha512": {
          "description": "SHA-512 of that unsigned nupkg: the NuGet contentHash that consumer lock files store.",
          "$ref": "#/$defs/sha512"
        },
        "nugetOrgSignedSha256": {
          "description": "SHA-256 of the repository-signed file nuget.org serves; null before publication.",
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "nugetOrgSignedSha512": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha512"
            },
            {
              "type": "null"
            }
          ]
        },
        "repositorySignatureVerified": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "commit",
        "treeHash",
        "pullRequest",
        "releaseRunUrl",
        "ciRunUrl"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "tag": {
          "description": "The release tag; null for a workflow_dispatch dry run.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "commit": {
          "$ref": "#/$defs/gitObject"
        },
        "treeHash": {
          "$ref": "#/$defs/gitObject"
        },
        "pullRequest": {
          "description": "The merged pull request whose squash commit was tagged; null when none is found.",
          "anyOf": [
            {
              "$ref": "#/$defs/pullRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "releaseRunUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "ciRunUrl": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dotnetSdk",
        "runner",
        "toolchain",
        "roslynFloor",
        "analysisLevel"
      ],
      "properties": {
        "dotnetSdk": {
          "type": "string",
          "minLength": 1
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "imageOs",
            "imageVersion"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "imageOs": {
              "type": "string",
              "minLength": 1
            },
            "imageVersion": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "xmake",
            "msvcToolset",
            "msvcVersion",
            "windowsSdk"
          ],
          "properties": {
            "xmake": {
              "type": "string",
              "minLength": 1
            },
            "msvcToolset": {
              "type": "string",
              "minLength": 1
            },
            "msvcVersion": {
              "type": "string",
              "minLength": 1
            },
            "windowsSdk": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "roslynFloor": {
          "type": [
            "string",
            "null"
          ]
        },
        "analysisLevel": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "nativeBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packagePath",
        "sha256",
        "sourceFingerprint"
      ],
      "properties": {
        "packagePath": {
          "const": "build/native/cheatengine-sdk-lua-bridge.dll"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}:[0-9a-f]{64}$"
        }
      }
    },
    "ceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "supportProfileSha256"
      ],
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "supportProfileSha256": {
          "description": "Hash of docs/qualification/support-profile.json; null when the file is absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matrixSha256",
        "receipts"
      ],
      "properties": {
        "matrixSha256": {
          "description": "Hash of docs/qualification/matrix.json; null when the file is absent.",
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "receipts": {
          "description": "Every committed C3/C4 receipt (docs/qualification/receipts), sorted by receiptId. A scenario without a receipt is not executed on the host; it is never listed.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/receipt"
          }
        }
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "sha256",
        "spdxVersion",
        "attested"
      ],
      "properties": {
        "entry": {
          "const": "_manifest/spdx_2.2/manifest.spdx.json"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "spdxVersion": {
          "const": "SPDX-2.2"
        },
        "attested": {
          "type": "boolean"
        }
      }
    },
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenanceBundle",
        "sbomBundle"
      ],
      "properties": {
        "provenanceBundle": {
          "description": "Release asset name of the Sigstore bundle of the SLSA provenance attestation; null for a dry run.",
          "anyOf": [
            {
              "$ref": "#/$defs/bundleName"
            },
            {
              "type": "null"
            }
          ]
        },
        "sbomBundle": {
          "description": "Release asset name of the Sigstore bundle of the SPDX 2.2 SBOM attestation; null for a dry run.",
          "anyOf": [
            {
              "$ref": "#/$defs/bundleName"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "assets": {
      "description": "The entries of the SHA256SUMS release asset.",
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "createdUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "Published"
          }
        }
      },
      "then": {
        "properties": {
          "package": {
            "properties": {
              "nugetOrgSignedSha256": {
                "$ref": "#/$defs/sha256"
              },
              "nugetOrgSignedSha512": {
                "$ref": "#/$defs/sha512"
              },
              "repositorySignatureVerified": {
                "const": true
              }
            }
          },
          "source": {
            "properties": {
              "tag": {
                "type": "string"
              }
            }
          },
          "sbom": {
            "properties": {
              "attested": {
                "const": true
              }
            }
          },
          "attestations": {
            "properties": {
              "provenanceBundle": {
                "type": "string"
              },
              "sbomBundle": {
                "type": "string"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "package": {
            "properties": {
              "nugetOrgSignedSha256": {
                "type": "null"
              },
              "nugetOrgSignedSha512": {
                "type": "null"
              },
              "repositorySignatureVerified": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha512": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "bundleName": {
      "type": "string",
      "pattern": "^CheatEngine\\.SDK\\.[0-9A-Za-z.-]+\\.sigstore\\.json$"
    },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "headSha"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "headSha": {
          "$ref": "#/$defs/gitObject"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptId",
        "qualificationId",
        "level",
        "status",
        "sha256"
      ],
      "properties": {
        "receiptId": {
          "type": "string",
          "pattern": "^R-[0-9]{8}T[0-9]{6}Z-Q[0-9]{2}(\\.[a-z])?-[0-9a-f]{8}$"
        },
        "qualificationId": {
          "type": "string",
          "pattern": "^Q(0[1-9]|[1-3][0-9]|4[0-8])(\\.[a-z])?$"
        },
        "level": {
          "enum": [
            "C3",
            "C4"
          ]
        },
        "status": {
          "enum": [
            "Passed",
            "Failed",
            "NotApplicable"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[^\\\\/\\s]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
