<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Raw Lua 5.3 C API as one function-pointer table resolved from an injectable module handle, plus constants and macro equivalents. No policy.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Content participates in GetCopyToOutputDirectoryItems, so project-reference consumers receive the
       prebuilt bridge beside their own executable/plugin rather than only beside this library. Rebuilding
       the C source is a maintainer/CI operation; an ordinary managed build does not require xmake or a C compiler. -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="../../native/cheatengine-sdk-lua-bridge/runtimes/win-x64/native/cheatengine-sdk-lua-bridge.dll"
             Link="cheatengine-sdk-lua-bridge.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The repository-owned catalogue is the only source of generated managed operation numbers and bitmap. -->
    <AdditionalFiles Include="../../eng/lua-bridge/protected-operations.json"
                     Link="eng/lua-bridge/protected-operations.json" />
    <!-- Repo-only build input: this component is not packed and never reaches an SDK consumer. -->
    <ProjectReference Include="../../source-generators/CheatEngine.SDK.SourceGenerators.LuaBridgeContract/CheatEngine.SDK.SourceGenerators.LuaBridgeContract.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
