<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>CheatEngine.SDK</PackageId>
    <Description>Write Cheat Engine plugins in C# on .NET 10. Generated plugin entry point, Lua function bindings, typed Cheat Engine objects and addresses, and analyzers in one package.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CheatEngineNet/CheatEngine.SDK</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>cheat-engine;cheat-engine-plugin;sdk;lua;source-generator;roslyn-analyzer;reverse-engineering</PackageTags>
    <PackageReleaseNotes>$(PackageProjectUrl)/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <EnablePackageValidation>true</EnablePackageValidation>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);_CheatEngineSdkEmbedLibraries</TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_CheatEngineSdkPackRoslynComponents;_CheatEngineSdkPackLuaBridge</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!-- A pack without a build sets NoBuild for referenced projects too, which then fail with NETSDK1085 when asked to build. -->
  <PropertyGroup Condition="'$(NoBuild)' == 'true'">
    <BuildProjectReferences>false</BuildProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <!-- One source file packed to both locations, so they cannot drift. -->
    <None Update="build/CheatEngine.SDK.props" Pack="true" PackagePath="build/CheatEngine.SDK.props;buildTransitive/CheatEngine.SDK.props"/>
  </ItemGroup>

  <!-- PrivateAssets="all" keeps the embedded libraries out of the nuspec dependency group, so no phantom CheatEngine.SDK.Lua package is ever resolved. -->
  <ItemGroup Label="Libraries embedded under lib/net10.0">
    <ProjectReference Include="../../libs/CheatEngine.SDK.Abi/CheatEngine.SDK.Abi.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../../libs/CheatEngine.SDK.Annotations/CheatEngine.SDK.Annotations.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../../libs/CheatEngine.SDK.Engine/CheatEngine.SDK.Engine.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../../libs/CheatEngine.SDK.Hosting/CheatEngine.SDK.Hosting.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../../libs/CheatEngine.SDK.Lua.Interop/CheatEngine.SDK.Lua.Interop.csproj" PrivateAssets="all"/>
    <ProjectReference Include="../../libs/CheatEngine.SDK.Lua/CheatEngine.SDK.Lua.csproj" PrivateAssets="all"/>
  </ItemGroup>

  <!--
    OutputItemType="Analyzer" captures each component as an @(Analyzer) item, and PackAsAnalyzer (a name private to this
    build) selects them for packing under analyzers/dotnet/cs. CheatEngine.SDK.SourceGenerators.EngineApi is absent on purpose:
    it does not ship.
  -->
  <ItemGroup Label="Roslyn components packed under analyzers/dotnet/cs">
    <ProjectReference Include="../../analyzers/CheatEngine.SDK.Analyzers/CheatEngine.SDK.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" PackAsAnalyzer="true"/>
    <ProjectReference Include="../../analyzers/CheatEngine.SDK.Analyzers.CodeFixes/CheatEngine.SDK.Analyzers.CodeFixes.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" PackAsAnalyzer="true"/>
    <ProjectReference Include="../../source-generators/CheatEngine.SDK.SourceGenerators.EntryPoint/CheatEngine.SDK.SourceGenerators.EntryPoint.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" PackAsAnalyzer="true"/>
    <ProjectReference Include="../../source-generators/CheatEngine.SDK.SourceGenerators.LuaBindings/CheatEngine.SDK.SourceGenerators.LuaBindings.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" PackAsAnalyzer="true"/>
    <ProjectReference Include="../../source-generators/CheatEngine.SDK.SourceGenerators.Shared/CheatEngine.SDK.SourceGenerators.Shared.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" PackAsAnalyzer="true"/>
  </ItemGroup>

  <Target Name="_CheatEngineSdkCollectEmbeddedLibraries" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <_CheatEngineSdkEmbeddedLibrary Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference')->WithMetadataValue('PrivateAssets', 'all')->WithMetadataValue('Extension', '.dll'))"/>
    </ItemGroup>
  </Target>

  <!-- Each embedded assembly travels with its XML documentation file so plugin authors keep IntelliSense. -->
  <Target Name="_CheatEngineSdkEmbedLibraries" DependsOnTargets="_CheatEngineSdkCollectEmbeddedLibraries">
    <ItemGroup>
      <BuildOutputInPackage Include="@(_CheatEngineSdkEmbeddedLibrary)"/>
      <BuildOutputInPackage Include="%(_CheatEngineSdkEmbeddedLibrary.RootDir)%(_CheatEngineSdkEmbeddedLibrary.Directory)%(_CheatEngineSdkEmbeddedLibrary.Filename).xml"
                            Condition="Exists('%(_CheatEngineSdkEmbeddedLibrary.RootDir)%(_CheatEngineSdkEmbeddedLibrary.Directory)%(_CheatEngineSdkEmbeddedLibrary.Filename).xml')"/>
    </ItemGroup>
  </Target>

  <!-- Only each component's own DLL is packed, so a component must not take a runtime dependency. -->
  <Target Name="_CheatEngineSdkPackRoslynComponents" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(Analyzer->WithMetadataValue('PackAsAnalyzer', 'true'))" PackagePath="analyzers/dotnet/cs"/>
    </ItemGroup>
  </Target>

  <!-- The native protection shim is a runtime asset, not a build dependency. Consumers never need xmake or a C toolchain. -->
  <Target Name="_CheatEngineSdkPackLuaBridge">
    <PropertyGroup>
      <_CheatEngineSdkLuaBridgePath>$(RepoRoot)native\cheatengine-sdk-lua-bridge\runtimes\win-x64\native\cheatengine-sdk-lua-bridge.dll</_CheatEngineSdkLuaBridgePath>
    </PropertyGroup>
    <Error Condition="!Exists('$(_CheatEngineSdkLuaBridgePath)')"
           Text="The prebuilt Lua protection bridge is missing at '$(_CheatEngineSdkLuaBridgePath)'. Rebuild it with xmake before packing CheatEngine.SDK."/>
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_CheatEngineSdkLuaBridgePath)" PackagePath="runtimes/win-x64/native"/>
    </ItemGroup>
  </Target>

</Project>
