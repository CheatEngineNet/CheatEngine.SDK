<Project>
  <!--
    Packed under build/ only. NuGet imports it for a direct PackageReference, never for an indirect dependency. NuGet ignores
    restore-affecting settings here (TargetFramework, PackageReference), so none are set. Every default applies only while the
    property is still empty, so the consumer's project file wins.
  -->

  <PropertyGroup>
    <!-- Copies referenced assemblies next to the plugin and emits its runtimeconfig.json. Cheat Engine's own ce.runtimeconfig.json still decides the runtime. -->
    <EnableDynamicLoading Condition="'$(EnableDynamicLoading)' == ''">true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exposes the property to the entry-point generator as build_property.CheatEngineSdkGenerateEntryPoint. -->
    <CompilerVisibleProperty Include="CheatEngineSdkGenerateEntryPoint"/>
  </ItemGroup>
  <PropertyGroup>
    <!-- A direct package reference makes generation explicit. Without this build asset, the generator stays silent. Set false to write the manual CESDK.CESDK bootstrap. -->
    <CheatEngineSdkGenerateEntryPoint Condition="'$(CheatEngineSdkGenerateEntryPoint)' == ''">true</CheatEngineSdkGenerateEntryPoint>
  </PropertyGroup>

  <PropertyGroup>
    <_CheatEngineSdkLuaBridgePath>$(MSBuildThisFileDirectory)native\cheatengine-sdk-lua-bridge.dll</_CheatEngineSdkLuaBridgePath>
  </PropertyGroup>

  <!--
    A normal SDK Content item participates in output, publish and clean bookkeeping. This replaces hand-written Copy targets
    while preserving the one atomic plugin folder expected by Cheat Engine; the item originates only from this direct package
    build asset.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('$(_CheatEngineSdkLuaBridgePath)')">
    <Content Include="$(_CheatEngineSdkLuaBridgePath)"
             Link="cheatengine-sdk-lua-bridge.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false"
             Visible="false"/>
  </ItemGroup>
</Project>
