    <ProjectReference Include="../../libs/CESDK.Annotations/CESDK.Annotations.csproj"/>
    <ProjectReference Include="../../libs/CESDK.Lua.Interop/CESDK.Lua.Interop.csproj"/>
    <ProjectReference Include="../../libs/CESDK.Lua/CESDK.Lua.csproj"/>
  </ItemGroup>

</Project>
