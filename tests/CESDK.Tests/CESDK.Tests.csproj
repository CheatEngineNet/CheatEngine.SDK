<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately no ProjectReference, not even to src/CESDK: the packed .nupkg and what a plugin sees after restoring it
    are checked from outside the project graph. Infrastructure/PackagedUmbrellaFixture.cs runs 'dotnet pack' on
    src/CESDK/CESDK.csproj itself.
  -->

  <ItemGroup>
    <!-- Used by Infrastructure/ThrowawayConsumer.cs (MSBuild JSON output) and Infrastructure/NupkgInspector.cs (nuspec XML). -->
    <Using Include="System.Text.Json"/>
    <Using Include="System.Xml.Linq"/>
  </ItemGroup>

</Project>
