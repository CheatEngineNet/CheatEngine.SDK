<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Repository policy tests. They only read committed files (solution, Markdown, workflows, qualification and catalogue
    documents) and never build, pack or restore, so every change can run them in seconds. Deliberately no
    ProjectReference. The one exception is Governance/: it starts pwsh to run the repository's PowerShell policy code
    (pull request policy, health-check rules, repository-settings plan) against test vectors, offline.
  -->

  <ItemGroup>
    <Using Include="System.Xml.Linq"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      Workflows/: parses .github/workflows/*.yml and the composite actions.
      Governance/ reads workflows, the Dependabot configuration and issue forms with the representation model.
    -->
    <PackageReference Include="YamlDotNet"/>
  </ItemGroup>

</Project>
