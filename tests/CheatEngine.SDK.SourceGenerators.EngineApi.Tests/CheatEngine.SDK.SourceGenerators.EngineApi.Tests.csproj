<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces"/>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Normal reference: the tests need the generator type, not the generator running on the test code. -->
    <ProjectReference Include="../../source-generators/CheatEngine.SDK.SourceGenerators.EngineApi/CheatEngine.SDK.SourceGenerators.EngineApi.csproj"/>
    <!-- Real assemblies the generated code is compiled against and executed with. -->
    <ProjectReference Include="../../libs/CheatEngine.SDK.Annotations/CheatEngine.SDK.Annotations.csproj"/>
    <ProjectReference Include="../../libs/CheatEngine.SDK.Lua.Interop/CheatEngine.SDK.Lua.Interop.csproj"/>
    <ProjectReference Include="../../libs/CheatEngine.SDK.Lua/CheatEngine.SDK.Lua.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- The production specs and the project that wires them, embedded so the policy tests never need a workspace path at run time
         (https://learn.microsoft.com/dotnet/core/resources/manifest-file-names#logicalname-metadata). -->
    <EmbeddedResource Include="../../source-generators/CheatEngine.SDK.SourceGenerators.EngineApi/Specs/*.cheatengine-sdk-api.txt"
                      LogicalName="CheatEngine.SDK.EngineApi.Tests.Specs.%(Filename)%(Extension)" WithCulture="false"/>
    <EmbeddedResource Include="../../libs/CheatEngine.SDK.Engine/CheatEngine.SDK.Engine.csproj"
                      LogicalName="CheatEngine.SDK.EngineApi.Tests.EngineProject.xml" WithCulture="false"/>
    <!-- The committed text of the generated MemoryScalars file (the generator version is a placeholder). -->
    <EmbeddedResource Include="Expected/*.txt" LogicalName="CheatEngine.SDK.EngineApi.Tests.Expected.%(Filename)%(Extension)"
                      WithCulture="false"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Native Lua fixture (tests/CheatEngine.SDK.Tests.Shared/README.md). -->
    <ProjectReference Include="../CheatEngine.SDK.Tests.Shared/CheatEngine.SDK.Tests.Shared.csproj"/>
  </ItemGroup>

</Project>
